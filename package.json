{
  "name": "homedeck",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @homedeck/app tauri dev",
    "dev:web": "pnpm --filter @homedeck/app dev",
    "check": "bash scripts/check.sh",
    "fix": "prettier --write . && cargo fmt --all && cargo clippy --workspace --all-targets --fix --allow-dirty --allow-staged -q",
    "env:check": "bash scripts/doctor.sh",
    "ui:check": "node scripts/ui-check.mjs",
    "build:linux": "cd apps/desktop-mobile && NO_STRIP=true LINUXDEPLOY_EXCLUDED_LIBRARIES='libwayland-*' pnpm tauri build --bundles appimage deb && cd ../.. && bash scripts/check-appimage.sh target/release/bundle/appimage/*.AppImage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "hooks:install": "git config core.hooksPath .githooks && echo 'pre-push ativo: pnpm check roda antes de cada push'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
